<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for toppersclassroom.com (static site).

  IIS only serves file extensions it has a MIME map for; anything else returns
  404.3. Out of the box IIS knows nothing about .webp or .webmanifest, which is
  why every image on the site 404'd. Each entry is preceded by <remove> so the
  file stays safe to deploy even if the server already defines that extension
  (a duplicate mimeMap raises a 500.19 config error).

  Pages now live in folders as index.html (e.g. /bcs-viva-questions/), served
  by the <defaultDocument> rule below. This is the no-module route to clean,
  extension-less URLs. A prior attempt at adding a <rewrite> section without
  the URL Rewrite module installed took the whole site down with HTTP 500.19
  (0x8007000d): IIS doesn't recognise the section and rejects the entire
  config file. Don't add one without confirming the module is on the server.

  The <location> blocks at the bottom 301 the old .html paths to the new
  folder URLs. <httpRedirect> is core IIS - it does NOT need URL Rewrite.
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- images -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />

      <!-- app manifest + data -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <!-- fonts, for when self-hosted webfonts are added -->
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <!-- let browsers cache static assets for a week -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>

  <!-- ===================================================================
       301 redirects: old .html paths -> new folder URLs.
       httpRedirect is a core IIS feature; no URL Rewrite module required.
       Each <location> must sit here, as a sibling of <system.webServer>.
       =================================================================== -->

  <location path="course-special-bcs-health-batch-01.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-health-cadre-course-batch-01/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="course-special-bcs-health-batch-02.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-health-cadre-course-batch-02/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="course-special-bcs-health-batch-03.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-health-cadre-course-batch-03/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>

  <location path="course-51st-bcs-general-batch-01.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/51st-bcs-preliminary-course-batch-01/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="course-51st-bcs-general-batch-02.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/51st-bcs-preliminary-course-batch-02/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="course-51st-bcs-general-batch-03.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/51st-bcs-preliminary-course-batch-03/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>

  <location path="blog-preliminary-study-plan.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-preliminary-study-plan/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="blog-bangladesh-affairs-topics.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bangladesh-affairs-bcs-topics/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="blog-written-answer-structure.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-written-answer-structure/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="blog-viva-questions.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-viva-questions/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>

  <location path="resource-preliminary-study-plan.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-preliminary-routine/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="resource-bangladesh-affairs-notes.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bangladesh-affairs-notes/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="resource-written-answer-templates.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-written-answer-templates/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="resource-viva-board-question-bank.html">
    <system.webServer>
      <httpRedirect enabled="true" destination="/bcs-viva-question-bank/" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>

</configuration>

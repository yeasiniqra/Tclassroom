<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for toppersclassroom.com (static site).

  IIS only serves file extensions it has a MIME map for; anything else returns
  404.3. Out of the box IIS knows nothing about .webp or .webmanifest, which is
  why every image on the site 404'd. Each entry is preceded by <remove> so the
  file stays safe to deploy even if the server already defines that extension
  (a duplicate mimeMap raises a 500.19 config error).

  Pages are served at their real .html paths (e.g. /blog-viva-questions.html).
  Extension-less URLs need either the IIS URL Rewrite module or restructuring
  pages into folders as index.html - neither is in place here. A prior attempt
  at adding a <rewrite> section without the module installed took the whole
  site down with HTTP 500.19 (0x8007000d): IIS doesn't recognise the section
  and rejects the entire config file. Don't add one without confirming the
  module is actually installed on the server first.
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- images -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />

      <!-- app manifest + data -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <!-- fonts, for when self-hosted webfonts are added -->
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <!-- let browsers cache static assets for a week -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
